# dependencies (no trailing slash, so a symlinked node_modules is ignored too)
node_modules

# build output (the live site is published from the gh-pages branch)
dist/
*.tsbuildinfo

# generated from src/design/tokens.json by scripts/tokens.mjs on every dev, build and test run
src/design/tokens.css

# drawing renders (art/out is regenerated by the art scripts)
art/out/

# editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log
.env
.env.*
